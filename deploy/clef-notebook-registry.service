[Unit]
Description=Clef notebook lease registrar (dedicated Plexus pool)
Documentation=file:///home/hermes/projects/clef-llama-remote/docs/parallel-notebooks.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hermes/projects/clef-llama-remote
Environment=PYTHONUNBUFFERED=1
# Bind the literal tailnet IPv4 (re-check with `tailscale ip -4` before enabling).
Environment=CLEF_REGISTRY_HOST=100.121.214.107
Environment=PLEXUS_BASE_URL=https://plexus.nebulosa-bass.ts.net
ExecStart=/usr/bin/python3 /home/hermes/projects/clef-llama-remote/clef_registry.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
